# AWS Lambda application configuration template. NOT shell code: do not source.
# Copy to .env.dev with mode 0600 and edit in an editor. Never commit that copy.
# All real values and limits require operator decisions; this template is NOT runnable.
# API, Worker and Relay use separate copies/settings/roles. Never share API keys with other roles.
STAGE=<RUNTIME_STAGE>
ARC_STORAGE_REGION=<S3_REGION>
ARC_MOCK_ENABLED=false
ARC_MOCK_ENVIRONMENT=<IDENTITY_NAMESPACE>
ARC_MOCK_TABLE_NAME=<DYNAMODB_TABLE_NAME>
ARC_MOCK_REGION=<DYNAMODB_REGION>
# Required strict JSON, built for exactly one role; no production defaults are inferred.
ARC_JOURNEY_CONFIG=<ROLE_SPECIFIC_JSON_CONFIGURATION>
# Common JSON fields (all required):
# schema: 1; role: api|worker|relay; account_id; partition: aws|aws-cn|aws-us-gov;
# environment; region; state: {table_name,max_conflict_retries};
# sdk: {connect_timeout,read_timeout,total_max_attempts,retry_mode: standard|legacy};
# logs: {capacity,max_bytes,flush_budget_ms,response_reserve_ms,sdk:{same SDK fields}}.
# API/Worker also require:
# storage: {stage,bucket,directory,input_bytes,artifact_bytes};
# execution: {current_adapter_version:"arc-internal-detection-pending-v3",
# projection_version:"arc-local-projection-v1",retained_adapter_versions:[chosen retained versions]}.
# The supported retained version "arc-local-calculator-pending-v2" validates saved candidates
# only; it cannot run old uncomputed work using the changed detector. No automatic version migration.
# API adds api:{payload_limit}. Only API needs the private resume keyring below.
# Worker adds worker:{lease_seconds,retry_seconds,renewal_interval_seconds,
# renewal_timeout_seconds,processing_reserve_ms}.
# Relay adds relay:{queue_url,lease_seconds,retry_seconds,page_size,max_pages,processing_reserve_ms}.
# Queue URL must be Standard SQS in the explicit region/account (FIFO is unsupported).
# Scheduled Relay requires the explicitly initialized environment-bound progress row.
# Missing/corrupt/mismatched rows are never automatically created or reset.
# Each physical Query reads at most one raw entry; page_size*max_pages is the
# logical per-kind work budget. Explicit lease must pass the SDK/conflict/return
# budget check in aws_settings.py; this check is not an absolute AWS deadline guarantee.
# Prepare a create-only request offline with python -m mock_journey.relay_init
# --config <private-relay.json> --output <new-private-request.json>; no AWS call is made.
# STAGE/ARC_* scalar bindings above, when supplied, must agree with this JSON.
# AWS_ENDPOINT_URL* overrides are rejected. Credentials use the normal Lambda role provider.
# Logs use the same explicit table, with an independent bounded writer/client; capacity is shared.
# Flush budgets add bounded response delay and do not guarantee durability under freeze/termination.
# Resume keys: JSON object of version -> base64-encoded random key (>=32 bytes).
# Inject through an approved private mechanism. A Secret ARN is NOT a key value.
ARC_MOCK_RESUME_KEYS=<PRIVATE_RESUME_KEYRING_JSON>
ARC_MOCK_RESUME_KEY_VERSION=<RESUME_KEY_VERSION>
# Optional; blank disables Sentry. Never enable raw request/body capture.
SENTRY_DSN=
