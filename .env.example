# AWS Lambda application configuration template. NOT shell code: do not source.
# Copy to .env.dev with mode 0600 and edit in an editor. Never commit that copy.
# This template does not make the missing AWS Journey runtime operational.
STAGE=<RUNTIME_STAGE>
ARC_STORAGE_REGION=<S3_REGION>
ARC_MOCK_ENABLED=false
ARC_MOCK_ENVIRONMENT=<IDENTITY_NAMESPACE>
ARC_MOCK_TABLE_NAME=<DYNAMODB_TABLE_NAME>
ARC_MOCK_REGION=<DYNAMODB_REGION>
# Resume keys: JSON object of version -> base64-encoded random key (>=32 bytes).
# Inject through an approved private mechanism. A Secret ARN is NOT a key value.
ARC_MOCK_RESUME_KEYS=<PRIVATE_RESUME_KEYRING_JSON>
ARC_MOCK_RESUME_KEY_VERSION=<RESUME_KEY_VERSION>
# Optional; blank disables Sentry. Never enable raw request/body capture.
SENTRY_DSN=
