{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StsWhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "IamManageArcCalcLambdaRoles",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:CreateRole",
        "iam:PutRolePolicy"
      ],
      "Resource": "arn:aws:iam::150612770165:role/arcCalc*"
    },
    {
      "Sid": "IamAttachOnlyLambdaBasicExecutionRole",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": "arn:aws:iam::150612770165:role/arcCalc*",
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        }
      }
    },
    {
      "Sid": "IamPassArcCalcRoleToLambdaOnly",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::150612770165:role/arcCalc*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "LambdaManageArcCalcFunctions",
      "Effect": "Allow",
      "Action": [
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:ListVersionsByFunction",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:GetPolicy",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-2:150612770165:function:arc_calc_*",
        "arn:aws:lambda:us-east-2:150612770165:function:arc_calc_*:*"
      ]
    },
    {
      "Sid": "ApiGatewayRestApis",
      "Effect": "Allow",
      "Action": [
        "apigateway:GET",
        "apigateway:POST",
        "apigateway:PUT",
        "apigateway:PATCH",
        "apigateway:DELETE"
      ],
      "Resource": [
        "arn:aws:apigateway:us-east-2::/restapis",
        "arn:aws:apigateway:us-east-2::/restapis/*"
      ]
    },
    {
      "Sid": "LogsArcCalcLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DescribeLogStreams",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartLiveTail"
      ],
      "Resource": [
        "arn:aws:logs:us-east-2:150612770165:log-group:/aws/lambda/arc_calc_*",
        "arn:aws:logs:us-east-2:150612770165:log-group:/aws/lambda/arc_calc_*:*"
      ]
    },
    {
      "Sid": "LogsActionsWithoutResourceLevelSupport",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups",
        "logs:StopLiveTail"
      ],
      "Resource": "*"
    }
  ]
}
